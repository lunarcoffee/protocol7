{
    "name": "protocol7",
    "version": "0.1.0",
    "private": true,
    "description": "web-based desktop environment",
    "author": "lunarcoffee",
    "scripts": {
        "dev": "pnpm -r --parallel dev",
        "dev:frontend": "pnpm --F frontend dev",
        "dev:backend": "pnpm --F backend dev",
        "build": "pnpm -r --parallel build",
        "start": "pnpm -r --parallel start",
        "tsc": "pnpm -r --parallel tsc",
        "lint": "pnpm -r --parallel lint",
        "lint:fix": "pnpm -r --parallel lint:fix",
        "format": "oxfmt"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "oxfmt": "^0.73.0",
        "oxlint": "^1.88.0",
        "oxlint-tsgolint": "^7.0.2004",
        "typescript": "^7.0.2"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.14.0",
            "onFail": "download"
        }
    },
    "packageManager": "pnpm@12.14.0"
}
